   "updated": 1,
   "link": null,
   "locked": false,
   "strokeSharpness": "sharp",
   "text": "Measured: sequential 23 ms, 10,000 threads 2294 ms, same result.\nPer cell: 23 ms / 10,000 = 2.3 us of work.\n(2294 - 23) ms / 10,000 = about 227 us of thread cost per cell.\nThe threads spend 99% of the time being threads.",
   "originalText": "Measured: sequential 23 ms, 10,000 threads 2294 ms, same result.\nPer cell: 23 ms / 10,000 = 2.3 us of work.\n(2294 - 23) ms / 10,000 = about 227 us of thread cost per cell.\nThe threads spend 99% of the time being threads.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 75.2,
   "autoResize": true
  },

   "strokeSharpness": "sharp",
   "text": "Old code: index = j, so it reports seat 0 as the start\n(the taken seat) and books seats 0 and 1. Double booking.",
   "originalText": "Old code: index = j, so it reports seat 0 as the start\n(the taken seat) and books seats 0 and 1. Double booking.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 37.4,
   "autoResize": true
  },
  {
   "id": "e42",
   "type": "text",
   "x": 0,
   "y": 200,
   "width": 990.08,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 2,
   "strokeStyle": "solid",
